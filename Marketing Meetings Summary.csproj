<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Marketing_Meetings_Summary</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Include="bin\Debug\net10.0-windows\business-docx\scripts\generate-template.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />

  </ItemGroup>

  <ItemGroup>
    <Resource Include="logo.png" />
  </ItemGroup>

  <!-- The template XML must be present next to the executable at runtime.
       Marking it as Content with CopyToOutputDirectory ensures it is copied
       both when this project runs standalone and when it is referenced from
       the Projects Managers Control Center (which becomes the host BaseDirectory). -->
  <ItemGroup>
    <Content Include="Marketing_Meeting_Summary_Template.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
